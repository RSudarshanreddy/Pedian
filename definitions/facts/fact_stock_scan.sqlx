config {
  type: "incremental",
  schema: "data_options",
  name: "fact_stock_scan",
  uniqueKey: ["stock_key", "date_key"],
  bigquery: {
    partitionBy: "bar_date",
    clusterBy: ["ticker", "action"]
  },
  assertions: {
    uniqueKey: ["stock_key", "date_key"],
    nonNull: ["stock_key", "date_key", "ticker", "bar_date"]
  }
}

SELECT
  ds.stock_key,
  dd.date_key,
  dls.lifecycle_stage_key,
  S.Ticker AS ticker,
  S.Bar_Date AS bar_date,
  S.Action AS action,
  S.Setup_Type AS setup_type,
  S.Score AS score,
  S.Reason AS reason,
  S.Price AS price,
  S.Avg_Volatility AS avg_volatility,
  S.Median_Volatility AS median_volatility,
  S.Volatile_Days AS volatile_days,
  S.Volatility_Ratio AS volatility_ratio,
  S.Today_Range AS today_range,
  S.Today_Close_Move AS today_close_move,
  S.Gap_Pct AS gap_pct,
  S.Three_Day_Move AS three_day_move,
  S.Upper_Circuit_Like_Days AS upper_circuit_like_days,
  S.Recent_Range_Avg AS recent_range_avg,
  S.Recent_Range_Median AS recent_range_median,
  S.Range_3Pct_Days AS range_3pct_days,
  S.Range_3Pct_Ratio AS range_3pct_ratio,
  S.Continuation_3Pct_Hit_Rate AS continuation_3pct_hit_rate,
  S.Continuation_Sample AS continuation_sample,
  S.Continuation_Median_Upside AS continuation_median_upside,
  S.Continuation_End_Return AS continuation_end_return,
  S.Persistence_Rate AS persistence_rate,
  S.Persistence_Sample AS persistence_sample,
  S.Expected_Move AS expected_move,
  S.Persistence_Stability AS persistence_stability,
  S.Traded_Value_Cr AS traded_value_cr,
  S.Volume_Spike AS volume_spike,
  S.Pullback_Pct AS pullback_pct,
  S.Dist_Support_Pct AS dist_support_pct,
  S.Dist_MA20_Pct AS dist_ma20_pct,
  S.Entry AS entry,
  S.Stop_Loss AS stop_loss,
  S.Target AS target,
  S.Risk_Per_Share AS risk_per_share,
  S.Risk_Pct AS risk_pct,
  S.RR_Ratio AS rr_ratio,
  S.ATR AS atr,
  S.Max_Hold_Days AS max_hold_days,
  CURRENT_TIMESTAMP() AS loaded_at

FROM ${ref("daily_stocks_v2")} S

JOIN ${ref("dim_stock")} ds
  ON ds.ticker = S.Ticker

JOIN ${ref("dim_date")} dd
  ON dd.calendar_date = S.Bar_Date

-- LEFT JOIN: an unmapped/new Setup_Type should still land in the fact table
-- (with a NULL lifecycle_stage_key) rather than being silently dropped the
-- way an INNER JOIN would drop it.
LEFT JOIN ${ref("dim_lifecycle_stage")} dls
  ON dls.setup_type = S.Setup_Type

WHERE
  S.Ticker IS NOT NULL
  AND S.Bar_Date IS NOT NULL

${when(incremental(), `
  -- Widened from 2 to 14 days: a 2-day window means any Bar_Date older than
  -- that (a missed scan day, a backfill, a rerun after a bug fix) is
  -- silently unreachable by this incremental query forever. uniqueKey
  -- already makes reruns idempotent, so a wider window costs little and
  -- closes that gap.
  AND S.Bar_Date >= DATE_SUB(CURRENT_DATE(), INTERVAL 14 DAY)
`)}
